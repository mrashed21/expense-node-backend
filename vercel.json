{
  "version": 2,
  "rewrites": [
    { "source": "/api/cron/(.*)", "destination": "/api/cron/$1" },
    { "source": "/(.*)", "destination": "/api/index.ts" }
  ],
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "0 14 * * *" },
    { "path": "/api/cron/recurring", "schedule": "0 14 * * *" }
  ]
}
